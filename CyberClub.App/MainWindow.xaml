<Window x:Class="CyberClub.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="КиберКлуб — панель администратора" Width="1180" Height="790" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F2F4FA" FontFamily="Segoe UI" Language="ru-RU">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="#151B32"><DockPanel Margin="23,30"><StackPanel DockPanel.Dock="Top"><TextBlock Text="КИБЕРКЛУБ" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="УПРАВЛЕНИЕ КЛУБОМ" Foreground="#9DA8CD" FontSize="10" Margin="0,8,0,40"/>
<Button Content="Главная" Tag="Главная" Click="Navigate"/><Button Content="Сеансы" Tag="Сеансы" Click="Navigate"/><Button Content="Тарифы" Tag="Тарифы" Click="Navigate"/><Button Content="История" Tag="История" Click="Navigate"/>
</StackPanel><StackPanel VerticalAlignment="Bottom"><TextBlock Text="●  Локальный режим" Foreground="#9AE6C5"/><TextBlock Text="12 игровых мест · без сервера" Foreground="#9DA8CD" FontSize="11" Margin="0,8,0,0"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1" Margin="30,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock x:Name="Heading" Text="Главная" FontSize="30" FontWeight="Bold"/><TextBlock Text="Рабочее пространство администратора компьютерного клуба" Foreground="#6C7690" Margin="0,6,0,22"/></StackPanel>
<UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,22"><Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="СВОБОДНО МЕСТ" Foreground="#6C7690" FontSize="11"/><TextBlock x:Name="FreeCount" FontSize="30" FontWeight="Bold"/></StackPanel></Border><Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="АКТИВНЫЕ СЕАНСЫ" Foreground="#6C7690" FontSize="11"/><TextBlock x:Name="ActiveCount" FontSize="30" FontWeight="Bold"/></StackPanel></Border><Border Background="#E8E7FF" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="ВЫРУЧКА СЕГОДНЯ" FontSize="11"/><TextBlock x:Name="Revenue" FontSize="30" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
<Grid Grid.Row="2">
<ScrollViewer x:Name="Home" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Игровой зал" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/><ItemsControl x:Name="Stations"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="12" Margin="0,0,12,12" Padding="17"><StackPanel><TextBlock Text="ИГРОВОЕ МЕСТО" FontSize="10" Foreground="#78839B"/><TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" Margin="0,8"/><TextBlock Text="{Binding Status}" Foreground="{Binding Color}"/><Button Content="Выбрать" Tag="{Binding Number}" Click="SelectStation" Padding="10,7" Margin="0,12,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
<Grid x:Name="SessionsPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,18"><StackPanel><TextBlock Text="Новый сеанс" FontSize="20" FontWeight="SemiBold"/><WrapPanel Margin="0,15,0,0"><StackPanel Margin="0,0,16,0"><TextBlock Text="Игровое место"/><ComboBox x:Name="StationChoice" Width="150" Height="34"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Тариф"/><ComboBox x:Name="TariffChoice" Width="180" Height="34"/></StackPanel><Button Content="Начать сеанс" Click="StartSession" VerticalAlignment="Bottom"/></WrapPanel><TextBlock Text="Каждая начатая минута оплачивается. Цена фиксируется при запуске." Foreground="#6C7690" Margin="0,12,0,0"/></StackPanel></Border><Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="ActiveGrid"><DataGrid.Columns><DataGridTextColumn Header="Место" Binding="{Binding Station}" Width="80"/><DataGridTextColumn Header="Тариф" Binding="{Binding Tariff}" Width="*"/><DataGridTextColumn Header="Начало" Binding="{Binding Started, StringFormat={}{0:dd.MM HH:mm}}" Width="160"/><DataGridTextColumn Header="Цена за час" Binding="{Binding Rate, StringFormat={}{0:N2} ₽}" Width="130"/></DataGrid.Columns></DataGrid><Button Grid.Row="1" Content="Завершить выбранный сеанс" Click="FinishSession" HorizontalAlignment="Left" Margin="0,12,0,0"/></Grid></Grid>
<StackPanel x:Name="TariffsPanel" Visibility="Collapsed"><Border Background="White" CornerRadius="12" Padding="24"><StackPanel><TextBlock Text="Тарифы клуба" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Изменение цены действует только для новых сеансов." Foreground="#6C7690" Margin="0,10,0,20"/><DataGrid x:Name="TariffGrid" Height="150"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Рублей за час" Binding="{Binding HourlyRate}" Width="200"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,20,0,0"><ComboBox x:Name="RateChoice" Width="170" Height="36" Margin="0,0,14,0"/><TextBox x:Name="RateInput" Width="130" Height="36" Padding="8" Text="100" Margin="0,0,14,0"/><Button Content="Сохранить цену" Click="SaveRate"/></WrapPanel></StackPanel></Border></StackPanel>
<Grid x:Name="HistoryPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Завершённые сеансы" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/><DataGrid Grid.Row="1" x:Name="HistoryGrid"><DataGrid.Columns><DataGridTextColumn Header="Место" Binding="{Binding Station}" Width="65"/><DataGridTextColumn Header="Тариф" Binding="{Binding Tariff}" Width="*"/><DataGridTextColumn Header="Начало" Binding="{Binding Started, StringFormat={}{0:dd.MM HH:mm}}" Width="145"/><DataGridTextColumn Header="Завершение" Binding="{Binding Finished, StringFormat={}{0:dd.MM HH:mm}}" Width="145"/><DataGridTextColumn Header="Стоимость" Binding="{Binding Cost, StringFormat={}{0:N2} ₽}" Width="125"/></DataGrid.Columns></DataGrid></Grid>
</Grid><TextBlock Grid.Row="3" x:Name="Status" Foreground="#65708A" TextWrapping="Wrap" Margin="0,15,0,0"/>
</Grid></Grid></Window>
